{
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["astro/client"],
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "~convex/*": ["./convex/*"]
    }
  },
  "exclude": ["supabase/functions", "supabase"]
}
