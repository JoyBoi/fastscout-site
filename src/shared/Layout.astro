---
import { ViewTransitions } from 'astro:transitions';
import Toast from "../components/Toast.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { type Locale, defaultLocale, useTranslations, getLocaleFromUrl } from "../i18n";

interface Props {
  title?: string;
  locale?: Locale;
}

const { title = "AutoBridge" } = Astro.props;

// Import global styles
import "../styles/global.css";

// Get locale from URL or props
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pathname = Astro.url.pathname;
const pathWithoutLocale = pathname.replace(/^\/(fr|en|nl)/, '') || '/';

// Helper to get localized path
const localePath = (path: string) => `/${locale}${path === '/' ? '' : path}`;
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
    <ViewTransitions />
    <!-- Prevent flash of wrong theme — runs on initial load AND after Astro view transitions -->
    <script is:inline>
      (function(){
        function applyTheme(){
          var t = localStorage.getItem('ab-theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', t);
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <style is:inline>
      /* ===== DARK THEME (default) ===== */
      :root, [data-theme="dark"] {
        color-scheme: dark;

        /* Backgrounds */
        --color-bg: #09090B;
        --color-bg-subtle: #111113;
        --color-bg-card: #18181B;
        --color-bg-elevated: #1F1F23;

        /* Text — contrast-checked (WCAG AA on dark bg) */
        --color-text: #FAFAFA;
        --color-text-muted: #B4B4BC;
        --color-text-dim: #71717A;

        /* Accent — Cyan/Teal */
        --color-primary: #06B6D4;
        --color-primary-hover: #22D3EE;
        --color-primary-light: rgba(6, 182, 212, 0.1);
        --color-primary-glow: rgba(6, 182, 212, 0.25);

        /* Gradients */
        --gradient-primary: linear-gradient(135deg, #06B6D4 0%, #10B981 100%);
        --gradient-subtle: linear-gradient(135deg, rgba(6, 182, 212, 0.15) 0%, rgba(16, 185, 129, 0.08) 100%);
        --gradient-glow: radial-gradient(circle at center, rgba(6, 182, 212, 0.08) 0%, transparent 70%);

        /* Semantic */
        --color-accent: #F59E0B;
        --color-accent-light: rgba(245, 158, 11, 0.1);
        --color-success: #10B981;
        --color-success-light: rgba(16, 185, 129, 0.1);
        --color-success-border: rgba(16, 185, 129, 0.2);
        --color-danger: #EF4444;
        --color-danger-light: rgba(239, 68, 68, 0.08);
        --color-danger-border: rgba(239, 68, 68, 0.2);
        --color-warning: #F59E0B;
        --color-warning-light: rgba(245, 158, 11, 0.08);
        --color-border: rgba(255, 255, 255, 0.06);
        --color-border-hover: rgba(255, 255, 255, 0.12);

        /* Theme-aware component colors */
        --header-bg: rgba(9, 9, 11, 0.7);
        --header-border: rgba(255, 255, 255, 0.06);
        --header-inset: rgba(255, 255, 255, 0.03);
        --nav-hover-bg: rgba(255, 255, 255, 0.04);
        --mobile-nav-bg: rgba(9, 9, 11, 0.95);
        --card-bg: rgba(24, 24, 27, 0.85);
        --card-border: rgba(255, 255, 255, 0.06);
        --card-border-hover: rgba(255, 255, 255, 0.1);
        --input-bg: #111113;
        --input-border: rgba(255, 255, 255, 0.08);
        --footer-bg: #06060A;
        --footer-border: rgba(255, 255, 255, 0.06);
        --outline-border: rgba(255, 255, 255, 0.12);
        --outline-hover-border: rgba(255, 255, 255, 0.2);
        --outline-hover-bg: rgba(255, 255, 255, 0.04);
        --pill-bg: rgba(255, 255, 255, 0.04);
        --pill-border: rgba(255, 255, 255, 0.08);
        --pill-hover-bg: rgba(255, 255, 255, 0.08);
        --dot-pattern: url("data:image/svg+xml,%3Csvg width='32' height='32' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='16' cy='16' r='0.8' fill='rgba(255,255,255,0.03)'/%3E%3C/svg%3E");

        /* Shadows — Dark */
        --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.2);
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
        --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.4);
        --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.5);
        --shadow-xl: 0 24px 48px rgba(0, 0, 0, 0.6);
        --shadow-glow: 0 0 40px rgba(6, 182, 212, 0.15);
        --shadow-primary: 0 8px 32px rgba(6, 182, 212, 0.2);
        --shadow-float: 0 20px 40px rgba(0, 0, 0, 0.5);

        /* Radius */
        --radius: 12px;
        --radius-sm: 8px;
        --radius-lg: 20px;
        --radius-full: 100px;

        /* Spacing */
        --space-1: 8px;
        --space-2: 12px;
        --space-3: 16px;
        --space-4: 24px;
        --space-5: 32px;
        --space-6: 48px;
        --space-7: 64px;
        --space-8: 96px;
      }

      /* ===== LIGHT THEME ===== */
      [data-theme="light"] {
        color-scheme: light;

        /* Backgrounds */
        --color-bg: #F8F9FA;
        --color-bg-subtle: #F0F1F3;
        --color-bg-card: #FFFFFF;
        --color-bg-elevated: #FFFFFF;

        /* Text — dark on light, high contrast */
        --color-text: #111827;
        --color-text-muted: #4B5563;
        --color-text-dim: #6B7280;

        /* Accent — deeper cyan for light bg readability */
        --color-primary: #0891B2;
        --color-primary-hover: #0E7490;
        --color-primary-light: rgba(8, 145, 178, 0.08);
        --color-primary-glow: rgba(8, 145, 178, 0.15);

        /* Gradients */
        --gradient-primary: linear-gradient(135deg, #0891B2 0%, #059669 100%);
        --gradient-subtle: linear-gradient(135deg, rgba(8, 145, 178, 0.06) 0%, rgba(5, 150, 105, 0.04) 100%);
        --gradient-glow: radial-gradient(circle at center, rgba(8, 145, 178, 0.04) 0%, transparent 70%);

        /* Semantic */
        --color-accent: #D97706;
        --color-accent-light: rgba(217, 119, 6, 0.08);
        --color-success: #059669;
        --color-success-light: rgba(5, 150, 105, 0.08);
        --color-success-border: rgba(5, 150, 105, 0.2);
        --color-danger: #DC2626;
        --color-danger-light: rgba(220, 38, 38, 0.06);
        --color-danger-border: rgba(220, 38, 38, 0.2);
        --color-warning: #D97706;
        --color-warning-light: rgba(217, 119, 6, 0.06);
        --color-border: rgba(0, 0, 0, 0.08);
        --color-border-hover: rgba(0, 0, 0, 0.15);

        /* Theme-aware component colors */
        --header-bg: rgba(255, 255, 255, 0.8);
        --header-border: rgba(0, 0, 0, 0.06);
        --header-inset: rgba(255, 255, 255, 0.6);
        --nav-hover-bg: rgba(0, 0, 0, 0.04);
        --mobile-nav-bg: rgba(255, 255, 255, 0.97);
        --card-bg: #FFFFFF;
        --card-border: rgba(0, 0, 0, 0.06);
        --card-border-hover: rgba(0, 0, 0, 0.12);
        --input-bg: #F0F1F3;
        --input-border: rgba(0, 0, 0, 0.1);
        --footer-bg: #F0F1F3;
        --footer-border: rgba(0, 0, 0, 0.06);
        --outline-border: rgba(0, 0, 0, 0.12);
        --outline-hover-border: rgba(0, 0, 0, 0.25);
        --outline-hover-bg: rgba(0, 0, 0, 0.03);
        --pill-bg: rgba(0, 0, 0, 0.04);
        --pill-border: rgba(0, 0, 0, 0.08);
        --pill-hover-bg: rgba(0, 0, 0, 0.07);
        --dot-pattern: url("data:image/svg+xml,%3Csvg width='32' height='32' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='16' cy='16' r='0.8' fill='rgba(0,0,0,0.03)'/%3E%3C/svg%3E");

        /* Shadows — Light */
        --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.04);
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
        --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.08);
        --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.1);
        --shadow-xl: 0 24px 48px rgba(0, 0, 0, 0.12);
        --shadow-glow: 0 0 40px rgba(8, 145, 178, 0.08);
        --shadow-primary: 0 8px 32px rgba(8, 145, 178, 0.12);
        --shadow-float: 0 20px 40px rgba(0, 0, 0, 0.1);
      }

      /* Global Reset & Base */
      * { box-sizing: border-box; }
      html, body { height: 100%; overflow-x: hidden; }

      body {
        font-family: 'Outfit', sans-serif;
        margin: 0;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-size: 14px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        background-image: var(--dot-pattern);
        background-repeat: repeat;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        line-height: 1.15;
        letter-spacing: -0.02em;
      }

      a { color: inherit; text-decoration: none; transition: color 0.2s, opacity 0.2s; }
      a:hover { color: var(--color-primary); }

      /* Animations */
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes fadeInScale {
        from { opacity: 0; transform: scale(0.95) translateY(12px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
      }

      @keyframes slideUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
      }

      @keyframes shimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
      }

      @keyframes glow {
        0%, 100% { opacity: 0.5; }
        50% { opacity: 1; }
      }

      .animate-enter { animation: fadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards; opacity: 0; }
      .stagger-1 { animation-delay: 0.1s; }
      .stagger-2 { animation-delay: 0.2s; }
      .stagger-3 { animation-delay: 0.3s; }
      .stagger-4 { animation-delay: 0.4s; }

      /* Components */
      header {
        position: fixed;
        top: 16px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 100;
        width: 92%;
        max-width: 1000px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 20px;
        background: var(--header-bg);
        backdrop-filter: blur(20px) saturate(150%);
        -webkit-backdrop-filter: blur(20px) saturate(150%);
        border: 1px solid var(--header-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md), inset 0 1px 0 var(--header-inset);
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
        will-change: border-color;
      }

      header:hover {
        border-color: var(--color-primary-light);
        box-shadow: var(--shadow-md), var(--shadow-glow), inset 0 1px 0 var(--header-inset);
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        font-size: 17px;
        color: var(--color-text);
        letter-spacing: -0.3px;
      }
      .logo:hover { color: var(--color-text); }

      nav { display: flex; align-items: center; gap: 4px; }
      nav a {
        font-size: 13px;
        font-weight: 500;
        color: var(--color-text-muted);
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        transition: color 0.2s ease, background-color 0.2s ease;
      }
      nav a:hover {
        color: var(--color-text);
        background: var(--nav-hover-bg);
      }
      nav a[aria-current="page"] {
        color: var(--color-primary);
        background: var(--color-primary-light);
        font-weight: 600;
      }

      /* Mobile Menu Toggle */
      .mobile-menu-btn {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        color: var(--color-text);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 20px;
        border-radius: var(--radius-full);
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        font-size: 13px;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, opacity 0.2s ease;
        border: 1px solid transparent;
        cursor: pointer;
        letter-spacing: 0.01em;
        white-space: nowrap;
      }

      .btn-primary {
        background: var(--gradient-primary);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: none;
      }
      .btn-primary:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 0 24px rgba(6, 182, 212, 0.3), 0 8px 32px rgba(6, 182, 212, 0.2);
      }
      .btn-primary:active {
        transform: translateY(0);
      }

      .btn-outline {
        background: transparent;
        border: 1.5px solid var(--outline-border);
        color: var(--color-text);
      }
      .btn-outline:hover {
        color: var(--color-text);
        border-color: var(--outline-hover-border);
        background: var(--outline-hover-bg);
        transform: translateY(-1px);
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 var(--space-4);
      }

      .section { padding: 100px 0 60px; }

      .card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-lg);
        padding: var(--space-4);
        position: relative;
        overflow: hidden;
        box-shadow: var(--shadow-xs);
        transition: box-shadow 0.3s ease, border-color 0.3s ease;
      }
      .card:hover {
        box-shadow: var(--shadow-md);
        border-color: var(--card-border-hover);
      }
      .card::before { display: none; }

      .grid { display: grid; gap: var(--space-4); }
      .grid-2 { grid-template-columns: repeat(2, 1fr); }
      .grid-3 { grid-template-columns: repeat(3, 1fr); }

      /* Utilities */
      .badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 12px;
        border-radius: var(--radius-full);
        background: var(--color-primary-light);
        color: var(--color-primary);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 1px solid rgba(6, 182, 212, 0.15);
        backdrop-filter: blur(8px);
      }

      .status-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-success);
        margin-right: 8px;
        box-shadow: 0 0 8px rgba(16, 185, 129, 0.3);
      }
      .status-dot.inactive { background: var(--color-text-dim); box-shadow: none; }

      .feature-list {
        list-style: none;
        padding: 0;
        margin: 24px 0;
      }
      .feature-list li {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        color: var(--color-text);
        font-size: 13px;
        font-weight: 400;
      }
      .feature-list li::before {
        content: "\2713";
        display: flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        min-width: 18px;
        background: var(--color-primary);
        color: white;
        border-radius: 50%;
        font-size: 10px;
        font-weight: bold;
        box-shadow: 0 0 12px rgba(6, 182, 212, 0.2);
      }

      /* User pill in header */
      .user-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 4px 14px 4px 4px;
        border-radius: var(--radius-full);
        background: var(--pill-bg);
        border: 1px solid var(--pill-border);
        font-size: 13px;
        font-weight: 500;
        color: var(--color-text);
        transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.25s ease;
        position: relative;
        text-decoration: none;
      }
      .user-pill:hover {
        background: var(--pill-hover-bg);
        border-color: var(--color-primary-light);
        color: var(--color-text);
        box-shadow: 0 0 20px rgba(6, 182, 212, 0.08);
      }
      .user-pill[aria-current="page"] {
        background: var(--color-primary-light);
        border-color: rgba(6, 182, 212, 0.2);
      }
      .user-pill-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--gradient-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 12px;
        color: white;
        flex-shrink: 0;
        letter-spacing: 0;
      }
      .user-pill-label {
        max-width: 120px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .user-pill-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--color-success);
        box-shadow: 0 0 6px rgba(16, 185, 129, 0.5);
        flex-shrink: 0;
      }

      /* Smooth auth nav toggling */
      .nav-auth-link {
        transition: opacity 0.25s ease, transform 0.25s ease;
      }
      .nav-auth-hidden {
        opacity: 0;
        pointer-events: none;
        position: absolute;
        transform: scale(0.95);
      }
      .nav-auth-visible {
        opacity: 1;
        pointer-events: auto;
        position: relative;
        transform: scale(1);
      }

      /* Page transition loading bar */
      .page-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        background: var(--gradient-primary);
        z-index: 9999;
        transition: width 0.3s ease;
        pointer-events: none;
        box-shadow: 0 0 8px rgba(6, 182, 212, 0.4);
      }

      /* Astro view transition animations */
      ::view-transition-old(root) {
        animation: vtFadeOut 0.15s ease-in forwards;
      }
      ::view-transition-new(root) {
        animation: vtFadeIn 0.25s ease-out forwards;
      }
      @keyframes vtFadeOut {
        from { opacity: 1; }
        to { opacity: 0; }
      }
      @keyframes vtFadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* Theme toggle */
      .theme-toggle {
        background: none;
        border: none;
        cursor: pointer;
        padding: 6px;
        color: var(--color-text-muted);
        border-radius: var(--radius-sm);
        transition: color 0.2s ease, background-color 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .theme-toggle:hover {
        color: var(--color-text);
        background: var(--nav-hover-bg);
      }
      /* Default: show sun (switch-to-light), hide moon — covers missing data-theme */
      .theme-toggle .icon-sun { display: block; }
      .theme-toggle .icon-moon { display: none; }
      [data-theme="light"] .theme-toggle .icon-sun { display: none; }
      [data-theme="light"] .theme-toggle .icon-moon { display: block; }

      .muted { color: var(--color-text-muted); }

      .lead {
        font-size: 15px;
        color: var(--color-text-muted);
        line-height: 1.7;
      }

      .text-gradient {
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .footer-link {
        color: var(--color-text-muted);
        font-size: 13px;
        transition: color 0.15s ease;
      }
      .footer-link:hover { color: var(--color-primary); }

      /* Form Elements */
      input, select, textarea {
        background: var(--input-bg);
        border: 1.5px solid var(--input-border);
        color: var(--color-text);
        padding: 10px 14px;
        border-radius: var(--radius-sm);
        font-family: inherit;
        font-size: 13px;
        width: 100%;
        outline: none;
        transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      }

      input::placeholder, select::placeholder, textarea::placeholder {
        color: var(--color-text-dim);
      }

      input:focus, select:focus, textarea:focus {
        background: var(--color-bg-card);
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1), 0 0 20px rgba(6, 182, 212, 0.05);
      }

      /* Focus styles for accessibility */
      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      /* Remove default focus outline (replaced by focus-visible) */
      a:focus:not(:focus-visible),
      button:focus:not(:focus-visible) {
        outline: none;
      }

      @media (max-width: 900px) {
        .mobile-menu-btn { display: block; }

        header {
          padding: 10px 16px;
        }

        nav {
          position: fixed;
          top: 72px;
          left: 50%;
          transform: translateX(-50%) translateY(-8px);
          width: 92%;
          background: var(--mobile-nav-bg);
          backdrop-filter: blur(20px);
          -webkit-backdrop-filter: blur(20px);
          border: 1px solid var(--header-border);
          border-radius: var(--radius-lg);
          padding: 16px;
          flex-direction: column;
          align-items: stretch;
          box-shadow: var(--shadow-xl);
          opacity: 0;
          pointer-events: none;
          transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
          will-change: opacity, transform;
        }

        nav.is-open {
          opacity: 1;
          pointer-events: all;
          transform: translateX(-50%) translateY(0);
        }

        nav a {
          text-align: center;
          padding: 12px;
          border-radius: var(--radius-sm);
        }

        .section { padding: 80px 0 40px; }
      }

      @media (max-width: 768px) {
        .grid-2, .grid-3 { grid-template-columns: 1fr; }
      }
    </style>
    <script src="https://js.stripe.com/v3" async></script>
  </head>
  <body>
    <header>
      <div>
        <a class="logo" href={localePath('/')}>
          <img src="/logo.png" alt="AutoBridge Logo" style="width: 32px; height: 32px;" />
          AutoBridge
        </a>
      </div>
      <button class="mobile-menu-btn" aria-label="Menu" id="mobile-menu-toggle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
      <nav aria-label="Main navigation" id="main-nav">
        <LanguageSwitcher locale={locale} />
        <a href={localePath('/pricing')} aria-current={pathWithoutLocale === '/pricing' ? "page" : undefined}>{t.nav.pricing}</a>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" type="button">
          <svg class="icon-sun" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="icon-moon" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        </button>
        <!-- Client-side auth-aware nav links -->
        <a class="btn btn-primary nav-auth-link" href={localePath('/auth')} data-nav="guest">{t.nav.signIn}</a>
        <a href={localePath('/dashboard')} class="user-pill nav-auth-link nav-auth-hidden" data-nav="user" aria-current={pathWithoutLocale === '/dashboard' ? "page" : undefined}>
          <span class="user-pill-avatar" id="nav-avatar">U</span>
          <span class="user-pill-label" id="nav-label">{t.nav.dashboard}</span>
          <span class="user-pill-dot"></span>
        </a>
      </nav>
    </header>
    <main class="container section">
      <slot />
    </main>

    <footer style="background: var(--footer-bg); padding: 0 0 40px; border-top: none; position: relative;">
      <div style="height: 1px; background: var(--gradient-primary); opacity: 0.2; margin-bottom: 80px;"></div>
      <div class="container">
        <div class="grid grid-3" style="margin-bottom: 60px;">
          <!-- Brand -->
          <div>
            <a class="logo" href={localePath('/')} style="margin-bottom: 16px; display:inline-flex;">
              <img src="/logo.png" alt="AutoBridge Logo" style="width: 32px; height: 32px;" />
              AutoBridge
            </a>
            <p class="muted" style="max-width: 280px; line-height: 1.7;">
              {t.footer.tagline}<br>
              {t.footer.description}
            </p>
          </div>

          <!-- Product -->
          <div>
            <h4 style="font-weight: 700; margin-bottom: 20px; font-size: 16px;">{t.footer.product}</h4>
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <a href={localePath('/pricing')} class="footer-link">{t.nav.pricing}</a>
              <a href={localePath('/dashboard')} class="footer-link">{t.nav.dashboard}</a>
              <a href={localePath('/extension')} class="footer-link">{t.footer.extension}</a>
            </div>
          </div>

          <!-- Resources -->
          <div>
            <h4 style="font-weight: 700; margin-bottom: 20px; font-size: 16px;">{t.footer.resources}</h4>
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <a href={localePath('/docs')} class="footer-link">{t.footer.documentation}</a>
              <a href={localePath('/contact')} class="footer-link">{t.footer.support}</a>
              <a href={localePath('/terms')} class="footer-link">{t.footer.terms}</a>
              <a href={localePath('/privacy')} class="footer-link">{t.footer.privacy}</a>
            </div>
          </div>
        </div>

        <div style="border-top: 1px solid var(--footer-border); padding-top: 32px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
          <p class="muted" style="font-size: 14px;">&copy; {new Date().getFullYear()} AutoBridge. {t.footer.copyright}</p>
        </div>
      </div>
    </footer>
    <Toast locale={locale} />

    <script>
      // Session cache — avoids redundant API calls during navigation
      let _sessionCache: { data: any; ts: number } | null = null;
      const SESSION_TTL = 60_000; // 1 minute

      function getCachedSession(): Promise<any> {
        if (_sessionCache && Date.now() - _sessionCache.ts < SESSION_TTL) {
          return Promise.resolve(_sessionCache.data);
        }
        return fetch('/api/session', { method: 'POST', credentials: 'same-origin' })
          .then(r => r.json())
          .then(data => {
            _sessionCache = { data, ts: Date.now() };
            return data;
          })
          .catch(() => null);
      }

      // Smooth auth link toggling (opacity transition, no layout shift)
      function toggleAuthLinks(isSignedIn: boolean) {
        document.querySelectorAll('[data-nav="guest"]').forEach(el => {
          el.classList.toggle('nav-auth-hidden', isSignedIn);
          el.classList.toggle('nav-auth-visible', !isSignedIn);
        });
        document.querySelectorAll('[data-nav="user"]').forEach(el => {
          el.classList.toggle('nav-auth-hidden', !isSignedIn);
          el.classList.toggle('nav-auth-visible', isSignedIn);
        });
        document.querySelectorAll('[data-cta="guest"]').forEach(el => {
          (el as HTMLElement).style.display = isSignedIn ? 'none' : '';
        });
        document.querySelectorAll('[data-cta="user"]').forEach(el => {
          (el as HTMLElement).style.display = isSignedIn ? '' : 'none';
        });
      }

      function updateAuthUI() {
        const isSignedIn = document.cookie.includes('ab_session');
        toggleAuthLinks(isSignedIn);

        if (isSignedIn) {
          getCachedSession().then(data => {
            if (data?.authenticated && data.email) {
              const avatar = document.getElementById('nav-avatar');
              const label = document.getElementById('nav-label');
              if (avatar) avatar.textContent = data.email.charAt(0).toUpperCase();
              if (label) label.textContent = data.displayName || data.email.split('@')[0];
            }
          });
        }
      }

      // Theme toggle
      function setupThemeToggle() {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') || 'dark';
          const next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('ab-theme', next);
        });
      }

      // Mobile Menu Toggle
      function setupMobileMenu() {
        const btn = document.getElementById('mobile-menu-toggle');
        const nav = document.getElementById('main-nav');
        if (btn && nav) {
          btn.addEventListener('click', () => nav.classList.toggle('is-open'));
          nav.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => nav.classList.remove('is-open'));
          });
        }
      }

      // Page transition loading bar
      let progressBar: HTMLElement | null = null;
      function showProgress() {
        if (progressBar) progressBar.remove();
        progressBar = document.createElement('div');
        progressBar.className = 'page-progress';
        progressBar.style.width = '0%';
        document.body.appendChild(progressBar);
        // Trigger reflow then animate
        requestAnimationFrame(() => {
          if (progressBar) progressBar.style.width = '70%';
        });
      }
      function completeProgress() {
        if (progressBar) {
          progressBar.style.width = '100%';
          progressBar.style.opacity = '0';
          progressBar.style.transition = 'width 0.15s ease, opacity 0.3s ease 0.1s';
          setTimeout(() => { progressBar?.remove(); progressBar = null; }, 400);
        }
      }

      // Astro page transition hooks
      document.addEventListener('astro:before-preparation', showProgress);
      document.addEventListener('astro:after-swap', completeProgress);

      // Init
      document.addEventListener('DOMContentLoaded', () => {
        updateAuthUI();
        setupMobileMenu();
        setupThemeToggle();
      });
      document.addEventListener('astro:page-load', () => {
        updateAuthUI();
        setupMobileMenu();
        setupThemeToggle();
      });
    </script>
  </body>

</html>
