---
import { ViewTransitions } from 'astro:transitions';
import Toast from "../components/Toast.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { type Locale, defaultLocale, useTranslations, getLocaleFromUrl } from "../i18n";

interface Props {
  title?: string;
  locale?: Locale;
}

const { title = "AutoBridge" } = Astro.props;

// Import global styles
import "../styles/global.css";

// Get locale from URL or props
const locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const pathname = Astro.url.pathname;
const pathWithoutLocale = pathname.replace(/^\/(fr|en|nl)/, '') || '/';

// Helper to get localized path
const localePath = (path: string) => `/${locale}${path === '/' ? '' : path}`;
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <ViewTransitions />
    <style is:inline>
      :root {
        color-scheme: dark;

        /* Backgrounds */
        --color-bg: #09090B;
        --color-bg-subtle: #111113;
        --color-bg-card: #18181B;
        --color-bg-elevated: #1F1F23;

        /* Text */
        --color-text: #FAFAFA;
        --color-text-muted: #A1A1AA;
        --color-text-dim: #52525B;

        /* Accent — Cyan/Teal */
        --color-primary: #06B6D4;
        --color-primary-light: rgba(6, 182, 212, 0.1);
        --color-primary-glow: rgba(6, 182, 212, 0.25);

        /* Gradients */
        --gradient-primary: linear-gradient(135deg, #06B6D4 0%, #10B981 100%);
        --gradient-subtle: linear-gradient(135deg, rgba(6, 182, 212, 0.15) 0%, rgba(16, 185, 129, 0.08) 100%);
        --gradient-glow: radial-gradient(circle at center, rgba(6, 182, 212, 0.08) 0%, transparent 70%);

        /* Semantic */
        --color-accent: #F59E0B;
        --color-accent-light: rgba(245, 158, 11, 0.1);
        --color-success: #10B981;
        --color-danger: #EF4444;
        --color-border: rgba(255, 255, 255, 0.06);
        --color-border-hover: rgba(255, 255, 255, 0.12);

        /* Shadows — Dark mode */
        --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.2);
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
        --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.4);
        --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.5);
        --shadow-xl: 0 24px 48px rgba(0, 0, 0, 0.6);
        --shadow-glow: 0 0 40px rgba(6, 182, 212, 0.15);
        --shadow-primary: 0 8px 32px rgba(6, 182, 212, 0.2);
        --shadow-float: 0 20px 40px rgba(0, 0, 0, 0.5);

        /* Radius */
        --radius: 12px;
        --radius-sm: 8px;
        --radius-lg: 20px;
        --radius-full: 100px;

        /* Spacing */
        --space-1: 8px;
        --space-2: 12px;
        --space-3: 16px;
        --space-4: 24px;
        --space-5: 32px;
        --space-6: 48px;
        --space-7: 64px;
        --space-8: 96px;
      }

      /* Global Reset & Base */
      * { box-sizing: border-box; }
      html, body { height: 100%; overflow-x: hidden; }

      body {
        font-family: 'Outfit', sans-serif;
        margin: 0;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-size: 14px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Subtle dot-grid pattern */
      body::before {
        content: '';
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background-image: radial-gradient(circle, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 32px 32px;
        pointer-events: none;
        z-index: 1;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: 'Syne', sans-serif;
        line-height: 1.15;
        letter-spacing: -0.02em;
      }

      a { color: inherit; text-decoration: none; transition: color 0.2s, opacity 0.2s; }
      a:hover { color: var(--color-primary); }

      /* Animations */
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes fadeInScale {
        from { opacity: 0; transform: scale(0.95) translateY(12px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
      }

      @keyframes slideUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes float {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0px); }
      }

      @keyframes shimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
      }

      @keyframes glow {
        0%, 100% { opacity: 0.5; }
        50% { opacity: 1; }
      }

      .animate-enter { animation: fadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards; opacity: 0; }
      .stagger-1 { animation-delay: 0.1s; }
      .stagger-2 { animation-delay: 0.2s; }
      .stagger-3 { animation-delay: 0.3s; }
      .stagger-4 { animation-delay: 0.4s; }

      /* Components */
      header {
        position: fixed;
        top: 16px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 100;
        width: 92%;
        max-width: 1000px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 20px;
        background: rgba(9, 9, 11, 0.7);
        backdrop-filter: blur(20px) saturate(150%);
        -webkit-backdrop-filter: blur(20px) saturate(150%);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: var(--radius-lg);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.03);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }

      header:hover {
        border-color: rgba(6, 182, 212, 0.1);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.4), 0 0 40px rgba(6, 182, 212, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.04);
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-family: 'Syne', sans-serif;
        font-weight: 700;
        font-size: 17px;
        color: var(--color-text);
        letter-spacing: -0.3px;
      }
      .logo:hover { color: var(--color-text); }

      nav { display: flex; align-items: center; gap: 4px; }
      nav a {
        font-size: 13px;
        font-weight: 500;
        color: var(--color-text-muted);
        padding: 8px 16px;
        border-radius: var(--radius-sm);
        transition: all 0.2s ease;
      }
      nav a:hover {
        color: var(--color-text);
        background: rgba(255, 255, 255, 0.04);
      }
      nav a[aria-current="page"] {
        color: var(--color-primary);
        background: var(--color-primary-light);
        font-weight: 600;
      }

      /* Mobile Menu Toggle */
      .mobile-menu-btn {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        color: var(--color-text);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 20px;
        border-radius: var(--radius-full);
        font-family: 'Outfit', sans-serif;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        border: 1px solid transparent;
        cursor: pointer;
        letter-spacing: 0.01em;
        white-space: nowrap;
      }

      .btn-primary {
        background: var(--gradient-primary);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: none;
      }
      .btn-primary:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 0 24px rgba(6, 182, 212, 0.3), 0 8px 32px rgba(6, 182, 212, 0.2);
      }
      .btn-primary:active {
        transform: translateY(0);
      }

      .btn-outline {
        background: transparent;
        border: 1.5px solid rgba(255, 255, 255, 0.12);
        color: var(--color-text);
      }
      .btn-outline:hover {
        color: var(--color-text);
        border-color: rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.04);
        transform: translateY(-1px);
        box-shadow: var(--shadow-sm);
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 var(--space-4);
      }

      .section { padding: 100px 0 60px; }

      .card {
        background: rgba(24, 24, 27, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: var(--radius-lg);
        padding: var(--space-4);
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: var(--shadow-xs);
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .card:hover {
        box-shadow: var(--shadow-md), 0 0 32px rgba(6, 182, 212, 0.05);
        border-color: rgba(255, 255, 255, 0.1);
      }
      .card::before { display: none; }

      .grid { display: grid; gap: var(--space-4); }
      .grid-2 { grid-template-columns: repeat(2, 1fr); }
      .grid-3 { grid-template-columns: repeat(3, 1fr); }

      /* Utilities */
      .badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 12px;
        border-radius: var(--radius-full);
        background: var(--color-primary-light);
        color: var(--color-primary);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border: 1px solid rgba(6, 182, 212, 0.15);
        backdrop-filter: blur(8px);
      }

      .status-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-success);
        margin-right: 8px;
        box-shadow: 0 0 8px rgba(16, 185, 129, 0.3);
      }
      .status-dot.inactive { background: var(--color-text-dim); box-shadow: none; }

      .feature-list {
        list-style: none;
        padding: 0;
        margin: 24px 0;
      }
      .feature-list li {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
        color: var(--color-text);
        font-size: 13px;
        font-weight: 400;
      }
      .feature-list li::before {
        content: "\2713";
        display: flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        min-width: 18px;
        background: var(--color-primary);
        color: white;
        border-radius: 50%;
        font-size: 10px;
        font-weight: bold;
        box-shadow: 0 0 12px rgba(6, 182, 212, 0.2);
      }

      .muted { color: var(--color-text-muted); }

      .lead {
        font-size: 15px;
        color: var(--color-text-muted);
        line-height: 1.7;
      }

      .text-gradient {
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .footer-link {
        color: var(--color-text-muted);
        font-size: 13px;
        transition: color 0.15s ease;
      }
      .footer-link:hover { color: var(--color-primary); }

      /* Form Elements */
      input, select, textarea {
        background: #111113;
        border: 1.5px solid rgba(255, 255, 255, 0.08);
        color: var(--color-text);
        padding: 10px 14px;
        border-radius: var(--radius-sm);
        font-family: inherit;
        font-size: 13px;
        width: 100%;
        outline: none;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }

      input::placeholder, select::placeholder, textarea::placeholder {
        color: var(--color-text-dim);
      }

      input:focus, select:focus, textarea:focus {
        background: var(--color-bg-card);
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1), 0 0 20px rgba(6, 182, 212, 0.05);
      }

      /* Focus styles for accessibility */
      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      /* Remove default focus outline (replaced by focus-visible) */
      a:focus:not(:focus-visible),
      button:focus:not(:focus-visible) {
        outline: none;
      }

      @media (max-width: 900px) {
        .mobile-menu-btn { display: block; }

        header {
          padding: 10px 16px;
        }

        nav {
          position: fixed;
          top: 72px;
          left: 50%;
          transform: translateX(-50%) translateY(-8px);
          width: 92%;
          background: rgba(9, 9, 11, 0.95);
          backdrop-filter: blur(20px);
          -webkit-backdrop-filter: blur(20px);
          border: 1px solid rgba(255, 255, 255, 0.06);
          border-radius: var(--radius-lg);
          padding: 16px;
          flex-direction: column;
          align-items: stretch;
          box-shadow: var(--shadow-xl);
          opacity: 0;
          pointer-events: none;
          transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        nav.is-open {
          opacity: 1;
          pointer-events: all;
          transform: translateX(-50%) translateY(0);
        }

        nav a {
          text-align: center;
          padding: 12px;
          border-radius: var(--radius-sm);
        }

        .section { padding: 80px 0 40px; }
      }

      @media (max-width: 768px) {
        .grid-2, .grid-3 { grid-template-columns: 1fr; }
      }
    </style>
    <script src="https://js.stripe.com/v3" async></script>
  </head>
  <body>
    <header>
      <div>
        <a class="logo" href={localePath('/')}>
          <img src="/logo.png" alt="AutoBridge Logo" style="width: 32px; height: 32px;" />
          AutoBridge
        </a>
      </div>
      <button class="mobile-menu-btn" aria-label="Menu" id="mobile-menu-toggle">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
      <nav aria-label="Main navigation" id="main-nav">
        <LanguageSwitcher locale={locale} />
        <a href={localePath('/pricing')} aria-current={pathWithoutLocale === '/pricing' ? "page" : undefined}>{t.nav.pricing}</a>
        <!-- Client-side auth-aware nav links -->
        <a class="btn btn-primary" href={localePath('/auth')} data-nav="guest">{t.nav.signIn}</a>
        <a href={localePath('/dashboard')} data-nav="user" style="display:none;" aria-current={pathWithoutLocale === '/dashboard' ? "page" : undefined}>{t.nav.dashboard}</a>
      </nav>
    </header>
    <main class="container section">
      <slot />
    </main>

    <footer style="background: #06060A; padding: 0 0 40px; border-top: none; position: relative;">
      <div style="height: 1px; background: var(--gradient-primary); opacity: 0.2; margin-bottom: 80px;"></div>
      <div class="container">
        <div class="grid grid-3" style="margin-bottom: 60px;">
          <!-- Brand -->
          <div>
            <a class="logo" href={localePath('/')} style="margin-bottom: 16px; display:inline-flex;">
              <img src="/logo.png" alt="AutoBridge Logo" style="width: 32px; height: 32px;" />
              AutoBridge
            </a>
            <p class="muted" style="max-width: 280px; line-height: 1.7;">
              {t.footer.tagline}<br>
              {t.footer.description}
            </p>
          </div>

          <!-- Product -->
          <div>
            <h4 style="font-weight: 700; margin-bottom: 20px; font-size: 16px;">{t.footer.product}</h4>
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <a href={localePath('/pricing')} class="footer-link">{t.nav.pricing}</a>
              <a href={localePath('/dashboard')} class="footer-link">{t.nav.dashboard}</a>
              <a href={localePath('/extension')} class="footer-link">{t.footer.extension}</a>
            </div>
          </div>

          <!-- Resources -->
          <div>
            <h4 style="font-weight: 700; margin-bottom: 20px; font-size: 16px;">{t.footer.resources}</h4>
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <a href={localePath('/docs')} class="footer-link">{t.footer.documentation}</a>
              <a href={localePath('/contact')} class="footer-link">{t.footer.support}</a>
              <a href={localePath('/terms')} class="footer-link">{t.footer.terms}</a>
              <a href={localePath('/privacy')} class="footer-link">{t.footer.privacy}</a>
            </div>
          </div>
        </div>

        <div style="border-top: 1px solid rgba(255, 255, 255, 0.06); padding-top: 32px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
          <p class="muted" style="font-size: 14px;">&copy; {new Date().getFullYear()} AutoBridge. {t.footer.copyright}</p>
        </div>
      </div>
    </footer>
    <Toast locale={locale} />

    <script>
      // Client-side auth detection for Layout navigation
      function updateAuthUI() {
        const isSignedIn = document.cookie.includes('ab_session');

        // Toggle nav links
        document.querySelectorAll('[data-nav="guest"]').forEach(el => {
          (el as HTMLElement).style.display = isSignedIn ? 'none' : '';
        });
        document.querySelectorAll('[data-nav="user"]').forEach(el => {
          (el as HTMLElement).style.display = isSignedIn ? '' : 'none';
        });

        // Also toggle CTA buttons (data-cta) if present on page
        document.querySelectorAll('[data-cta="guest"]').forEach(el => {
          (el as HTMLElement).style.display = isSignedIn ? 'none' : '';
        });
        document.querySelectorAll('[data-cta="user"]').forEach(el => {
          (el as HTMLElement).style.display = isSignedIn ? '' : 'none';
        });
      }

      // Mobile Menu Toggle
      function setupMobileMenu() {
        const btn = document.getElementById('mobile-menu-toggle');
        const nav = document.getElementById('main-nav');
        if (btn && nav) {
            btn.addEventListener('click', () => {
                nav.classList.toggle('is-open');
            });
            // Close menu when clicking links
            nav.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', () => nav.classList.remove('is-open'));
            });
        }
      }

      // Run on load and after Astro page transitions
      document.addEventListener('DOMContentLoaded', () => {
        updateAuthUI();
        setupMobileMenu();
      });
      document.addEventListener('astro:page-load', () => {
        updateAuthUI();
        setupMobileMenu();
      });
    </script>
  </body>

</html>
