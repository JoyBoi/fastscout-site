---
export const prerender = true;
import Layout from "../../shared/Layout.astro";
import { locales, getLocaleFromUrl, useTranslations } from "../../i18n";

export function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const localePath = (path: string) => `/${locale}${path}`;
---

<Layout title="Documentation" locale={locale}>
  <section class="container section" style="padding-top: 48px;">
    <div style="text-align: center; margin-bottom: 48px;">
        <span class="badge" style="margin-bottom: 14px;">{t.docs.badge}</span>
        <h1 style="font-family: 'Syne', sans-serif; font-size: clamp(22px, 3vw, 28px); font-weight: 800; letter-spacing: -0.5px; margin-bottom: 16px; color: var(--color-text);">
          {t.docs.heroTitle1} <span class="text-gradient">{t.docs.heroTitle2}</span>
        </h1>
        <p class="lead" style="max-width: 540px; margin: 0 auto; font-size: 14px;">
          {t.docs.lead}
        </p>
    </div>

    <!-- Quick Links Grid -->
    <div class="grid grid-3" style="margin-bottom: 60px; gap: 16px;">
        <a href={localePath('/extension')} class="card docs-card">
            <div class="icon-box">🚀</div>
            <h3>{t.docs.quickLinks.start.title}</h3>
            <p class="muted">{t.docs.quickLinks.start.description}</p>
        </a>
        <a href={localePath('/extension')} class="card docs-card">
            <div class="icon-box">🧩</div>
            <h3>{t.docs.quickLinks.extension.title}</h3>
            <p class="muted">{t.docs.quickLinks.extension.description}</p>
        </a>
        <a href={localePath('/pricing')} class="card docs-card">
            <div class="icon-box">💳</div>
            <h3>{t.docs.quickLinks.billing.title}</h3>
            <p class="muted">{t.docs.quickLinks.billing.description}</p>
        </a>
    </div>

    <!-- FAQ Section -->
    <div style="max-width: 720px; margin: 0 auto;">
        <h2 style="font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; margin-bottom: 32px; text-align: center; color: var(--color-text);">{t.docs.faq.title}</h2>

        <div class="faq-item">
            <h4>{t.docs.faq.q1.title}</h4>
            <p class="muted">{t.docs.faq.q1.content}</p>
        </div>

        <div class="faq-item">
            <h4>{t.docs.faq.q2.title}</h4>
            <p class="muted">{t.docs.faq.q2.content}</p>
        </div>

        <div class="faq-item">
            <h4>{t.docs.faq.q3.title}</h4>
            <p class="muted">{t.docs.faq.q3.content}</p>
        </div>

        <div class="faq-item">
            <h4>{t.docs.faq.q4.title}</h4>
            <p class="muted">{t.docs.faq.q4.content}</p>
        </div>
    </div>

    <div style="margin-top: 60px; padding: 32px; background: var(--color-bg-card); border-radius: var(--radius-lg); text-align: center; border: 1px solid var(--color-border); backdrop-filter: blur(12px);">
        <h3 style="font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 700; margin-bottom: 12px; color: var(--color-text);">{t.docs.support.title}</h3>
        <p class="muted" style="margin-bottom: 20px; font-size: 13px;">{t.docs.support.description}</p>
        <a href="mailto:support@fastscout.app" class="btn btn-primary" style="font-size: 13px; padding: 10px 24px;">{t.docs.support.cta}</a>
    </div>

  </section>

  <style>
    .docs-card {
        text-decoration: none;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: block;
        padding: 20px;
    }
    .docs-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
        border-color: var(--color-border-hover);
    }
    .icon-box {
        width: 40px;
        height: 40px;
        background: rgba(6, 182, 212, 0.08);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 14px;
    }
    .docs-card h3 {
        font-family: 'Syne', sans-serif;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 6px;
        color: var(--color-text);
    }
    .docs-card p {
        font-size: 13px;
        line-height: 1.5;
    }
    .faq-item {
        background: var(--color-bg-card);
        border: 1px solid var(--color-border);
        padding: 20px;
        border-radius: var(--radius);
        margin-bottom: 12px;
        backdrop-filter: blur(12px);
    }
    .faq-item h4 {
        font-family: 'Syne', sans-serif;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 6px;
        color: var(--color-text);
    }
    .faq-item p {
        margin: 0;
        font-size: 13px;
        line-height: 1.6;
    }
  </style>
</Layout>
