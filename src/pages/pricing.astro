---
export const prerender = false;

import Layout from "../shared/Layout.astro";
import LoadingButton from "../components/LoadingButton.astro";
import { getConvexServerClient } from "../lib/convex";
import { api } from "../../convex/_generated/api";

let monthlyId = import.meta.env.STRIPE_PRICE_ID_MONTHLY as string | undefined;
const yearlyId = import.meta.env.STRIPE_PRICE_ID_YEARLY as string | undefined;
const fallbackId = import.meta.env.STRIPE_PRICE_ID as string | undefined;
if (!monthlyId && fallbackId) monthlyId = fallbackId;

const urlError = new URL(Astro.request.url).searchParams.get("error");
let errorBanner: string | null = null;
if (urlError === "rate_limited") errorBanner = "Too many requests. Try again in a minute.";
else if (urlError === "checkout_failed") errorBanner = "Checkout failed. Please try again.";
else if (urlError === "missing_price_id") errorBanner = "Price configuration missing.";
else if (urlError === "already_subscribed") errorBanner = "You already have an active subscription.";
let subActive = false;
let subPriceId: string | undefined;

const { client } = getConvexServerClient(Astro.request);
const subDoc = await client.query(api.subscriptions.getStatus);
if (subDoc) {
  subActive = subDoc.status === "active" || subDoc.status === "trialing";
  subPriceId = subDoc.priceId ?? undefined;
}

const quarterlyId = import.meta.env.STRIPE_PRICE_ID_QUARTERLY as string | undefined;
const halfyearlyId = import.meta.env.STRIPE_PRICE_ID_HALFYEARLY as string | undefined;
---
<Layout title="Pricing">
  <section class="pricing-section" data-billing="monthly">
    <div class="pricing-glow"></div>

    <div class="pricing-header">
      <span class="pricing-badge">Pricing</span>
      <h2 class="pricing-title">Choose your plan</h2>
      <p class="pricing-subtitle">Transparent pricing for automotive professionals.</p>
    </div>

    <div class="toggle-wrapper">
      <div class="toggle-track" id="billing-toggle">
        <div class="toggle-indicator"></div>
        <button class="toggle-btn active" data-period="monthly" type="button">Monthly</button>
        <button class="toggle-btn" data-period="annual" type="button">Annual</button>
      </div>
      <span class="toggle-save" id="toggle-save">-15%</span>
    </div>

    {errorBanner && (
      <div class="pricing-error">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <span>{errorBanner}</span>
        {urlError === "already_subscribed" && (
          <a class="btn btn-outline" href="/dashboard" style="margin-left:auto; font-size:12px; padding:6px 14px;">Dashboard</a>
        )}
      </div>
    )}

    <div class="pricing-grid">
      <div class="plan-card plan-card--starter">
        <div class="plan-top">
          <h3 class="plan-name">Starter</h3>
          <p class="plan-tagline">Get started</p>
        </div>
        <div class="plan-price-block">
          <div class="price-row price-monthly">
            <span class="price-amount">50&euro;</span>
            <span class="price-period">/mo</span>
          </div>
          <div class="price-row price-annual">
            <span class="price-amount">42.50&euro;</span>
            <span class="price-period">/mo</span>
            <span class="price-was"><s>50&euro;</s></span>
          </div>
          <p class="price-billed price-annual">Billed 510&euro;/year</p>
          <p class="price-extra">then 0.15&euro; / extra vehicle</p>
        </div>
        <ul class="plan-features">
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong>500</strong> vehicles / month</span></li>
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>FastBack & CarCollect extraction</span></li>
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>AutoScout24 auto-mapping</span></li>
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Chrome Extension</span></li>
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Dashboard & history</span></li>
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Email support</span></li>
        </ul>
        <div class="plan-cta">
          <div class="cta-monthly">
            {subActive && subPriceId === monthlyId ? (
              <button class="btn-plan btn-plan--outline" disabled>Current plan</button>
            ) : (
              <form action="/api/checkout" method="POST"><input type="hidden" name="plan" value="monthly" /><LoadingButton variant="outline" style="width:100%;">Get Started</LoadingButton></form>
            )}
          </div>
          <div class="cta-annual">
            {subActive && subPriceId === yearlyId ? (
              <button class="btn-plan btn-plan--outline" disabled>Current plan</button>
            ) : (
              <form action="/api/checkout" method="POST"><input type="hidden" name="plan" value="annual" /><LoadingButton variant="outline" style="width:100%;">Get Started</LoadingButton></form>
            )}
          </div>
        </div>
      </div>

      <div class="plan-card plan-card--pro">
        <div class="plan-glow-bar"></div>
        <div class="plan-popular-badge">Most Popular</div>
        <div class="plan-top">
          <h3 class="plan-name">Pro</h3>
          <p class="plan-tagline pro-tagline">Unlimited vehicles</p>
        </div>
        <div class="plan-price-block">
          <div class="price-row price-monthly">
            <span class="price-amount">250&euro;</span>
            <span class="price-period">/mo</span>
          </div>
          <div class="price-row price-annual">
            <span class="price-amount">212.50&euro;</span>
            <span class="price-period">/mo</span>
            <span class="price-was"><s>250&euro;</s></span>
          </div>
          <p class="price-billed price-annual">Billed 2,550&euro;/year</p>
          <p class="price-extra">then 0.08&euro; / extra vehicle</p>
        </div>
        <ul class="plan-features plan-features--pro">
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span><strong>Unlimited vehicles</strong></span></li>
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>FastBack & CarCollect extraction</span></li>
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>AutoScout24 auto-mapping</span></li>
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Chrome Extension</span></li>
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Dashboard & advanced analytics</span></li>
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Priority support</span></li>
          <li><svg class="check-icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Early access to new features</span></li>
        </ul>
        <div class="plan-cta">
          <div class="cta-monthly">
            {subActive && subPriceId === quarterlyId ? (
              <button class="btn-plan btn-plan--primary" disabled>Current plan</button>
            ) : (
              <form action="/api/checkout" method="POST"><input type="hidden" name="plan" value="quarterly" /><LoadingButton variant="primary" style="width:100%;">Go Pro</LoadingButton></form>
            )}
          </div>
          <div class="cta-annual">
            {subActive && subPriceId === halfyearlyId ? (
              <button class="btn-plan btn-plan--primary" disabled>Current plan</button>
            ) : (
              <form action="/api/checkout" method="POST"><input type="hidden" name="plan" value="halfyearly" /><LoadingButton variant="primary" style="width:100%;">Go Pro</LoadingButton></form>
            )}
          </div>
        </div>
      </div>
    </div>

    <div class="trust-row">
      <div class="trust-item"><svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg><span>Secure payments via Stripe</span></div>
      <div class="trust-item"><svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>Cancel anytime</span></div>
      <div class="trust-item"><svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg><span>No hidden fees</span></div>
    </div>

    <div class="faq-section">
      <h3 class="faq-title">Frequently Asked Questions</h3>
      <div class="faq-list" id="faq-list">
        <div class="faq-item"><button class="faq-question" type="button"><span>Can I cancel anytime?</span><svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></button><div class="faq-answer"><p>Yes, absolutely. You can cancel your subscription at any time from your dashboard. Your access continues until the end of your billing period.</p></div></div>
        <div class="faq-item"><button class="faq-question" type="button"><span>How are invoices handled?</span><svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></button><div class="faq-answer"><p>Invoices are automatically generated and emailed to you. You can also view and download past invoices from your dashboard.</p></div></div>
        <div class="faq-item"><button class="faq-question" type="button"><span>What happens if I exceed 500 vehicles?</span><svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></button><div class="faq-answer"><p>No blocking. Extra vehicles beyond your included quota are billed per unit. You can also upgrade to Pro for a higher quota and lower per-vehicle rate.</p></div></div>
        <div class="faq-item"><button class="faq-question" type="button"><span>How does the Chrome extension work?</span><svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></button><div class="faq-answer"><p>AutoBridge connects to FastBack and CarCollect, extracts vehicle data, and automatically maps it to AutoScout24 fields. One click and your listing is ready.</p></div></div>
        <div class="faq-item"><button class="faq-question" type="button"><span>What happens if I exceed my quota?</span><svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></button><div class="faq-answer"><p>No blocking. Extra vehicles beyond your included quota are billed per unit (0.15&euro; for Starter, 0.08&euro; for Pro). The overage appears on your next invoice automatically.</p></div></div>
        <div class="faq-item"><button class="faq-question" type="button"><span>How do I track my usage?</span><svg class="faq-chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></button><div class="faq-answer"><p>Your dashboard shows real-time vehicle count for the current month against your quota. You can also view detailed operation history.</p></div></div>
      </div>
    </div>
  </section>

  <style is:inline>
    .pricing-section{max-width:880px;margin:0 auto;padding:0 24px 80px;position:relative}
    .pricing-glow{position:absolute;top:-120px;left:50%;transform:translateX(-50%);width:700px;height:500px;background:radial-gradient(ellipse at center,rgba(6,182,212,.06) 0%,rgba(99,102,241,.03) 40%,transparent 70%);pointer-events:none;z-index:0}
    .pricing-header{text-align:center;margin-bottom:40px;position:relative;z-index:1;animation:fadeUp .6s cubic-bezier(.16,1,.3,1) both}
    .pricing-badge{display:inline-block;padding:5px 14px;border-radius:var(--radius-full);background:rgba(6,182,212,.08);border:1px solid rgba(6,182,212,.15);color:var(--color-primary);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;margin-bottom:18px}
    .pricing-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(28px,4vw,44px);font-weight:800;letter-spacing:-.03em;color:var(--color-text);margin:0 0 12px;line-height:1.1}
    .pricing-subtitle{font-size:15px;color:var(--color-text-muted);max-width:420px;margin:0 auto;line-height:1.6}
    .toggle-wrapper{display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:44px;position:relative;z-index:1;animation:fadeUp .6s .1s cubic-bezier(.16,1,.3,1) both}
    .toggle-track{display:flex;position:relative;background:var(--color-bg-subtle);border:1px solid var(--color-border, rgba(255,255,255,.08));border-radius:var(--radius-full);padding:4px}
    .toggle-indicator{position:absolute;top:4px;left:4px;width:calc(50% - 4px);height:calc(100% - 8px);border-radius:var(--radius-full);background:var(--color-primary-light);border:1px solid rgba(6,182,212,.2);transition:transform .35s cubic-bezier(.16,1,.3,1)}
    .toggle-track[data-active="annual"] .toggle-indicator{transform:translateX(100%)}
    .toggle-btn{position:relative;z-index:1;padding:8px 24px;border:none;background:transparent;color:var(--color-text-dim);font-size:13px;font-weight:600;cursor:pointer;transition:color .3s ease;font-family:inherit}
    .toggle-btn.active{color:var(--color-text)}
    .toggle-save{display:inline-block;padding:4px 10px;border-radius:var(--radius-full);background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.2);color:#10B981;font-size:11px;font-weight:700;letter-spacing:.3px;opacity:0;transform:scale(.8);transition:all .35s cubic-bezier(.34,1.56,.64,1)}
    .toggle-save.visible{opacity:1;transform:scale(1)}
    .pricing-error{display:flex;align-items:center;gap:10px;padding:12px 18px;margin-bottom:28px;border-radius:var(--radius);background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.2);color:#f87171;font-size:13px;position:relative;z-index:1}
    .pricing-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;position:relative;z-index:1}
    .plan-card{padding:40px 32px 36px;border-radius:var(--radius-lg);display:flex;flex-direction:column;position:relative;transition:all .4s cubic-bezier(.16,1,.3,1);animation:fadeUp .6s cubic-bezier(.16,1,.3,1) both}
    .plan-card:hover{transform:translateY(-6px)}
    .plan-card--starter{background:var(--card-bg);backdrop-filter:blur(20px);border:1px solid var(--card-border);animation-delay:.15s}
    .plan-card--starter:hover{border-color:var(--card-border-hover);box-shadow:var(--shadow-lg)}
    .plan-card--pro{background:linear-gradient(var(--color-bg-card),var(--color-bg-card)) padding-box,var(--gradient-primary) border-box;border:2px solid transparent;backdrop-filter:blur(20px);box-shadow:var(--shadow-primary);animation-delay:.25s}
    .plan-card--pro:hover{box-shadow:0 28px 70px -12px rgba(6,182,212,.22)}
    .plan-glow-bar{position:absolute;top:0;left:0;right:0;height:3px;background:var(--gradient-primary);border-radius:var(--radius-lg) var(--radius-lg) 0 0}
    .plan-popular-badge{position:absolute;top:16px;right:20px;padding:4px 12px;border-radius:var(--radius-full);background:var(--color-primary-light);border:1px solid rgba(6,182,212,.2);color:var(--color-primary);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.8px}
    .plan-top{margin-bottom:28px}
    .plan-name{font-family:'Plus Jakarta Sans',sans-serif;font-size:20px;font-weight:800;margin:0 0 4px;letter-spacing:-.01em}
    .plan-tagline{font-size:13px;color:var(--color-text-dim);margin:0}
    .pro-tagline{color:var(--color-primary);font-weight:600}
    .plan-price-block{margin-bottom:28px;min-height:72px}
    .price-row{display:flex;align-items:baseline;gap:4px}
    .price-amount{font-family:'Plus Jakarta Sans',sans-serif;font-size:48px;font-weight:800;color:var(--color-text);line-height:1;letter-spacing:-.04em}
    .price-period{font-size:15px;color:var(--color-text-dim);font-weight:500}
    .price-was{font-size:14px;color:var(--color-text-dim);margin-left:8px}
    .price-billed{font-size:12px;color:var(--color-text-dim);margin:6px 0 0}
    .price-extra{font-size:11px;color:var(--color-text-dim);margin:8px 0 0;padding:5px 10px;background:var(--color-bg-subtle);border-radius:var(--radius-sm);border:1px dashed var(--card-border)}
    .price-annual{display:none}
    [data-billing="annual"] .price-monthly{display:none}
    [data-billing="annual"] .price-annual{display:flex}
    [data-billing="annual"] p.price-annual{display:block}
    .price-row{animation:priceIn .3s cubic-bezier(.16,1,.3,1) both}
    .cta-annual{display:none}
    [data-billing="annual"] .cta-monthly{display:none}
    [data-billing="annual"] .cta-annual{display:block}
    .plan-features{list-style:none;padding:0;margin:0 0 32px;flex-grow:1}
    .plan-features li{display:flex;align-items:center;gap:10px;padding:7px 0;font-size:13.5px;color:var(--color-text-muted);line-height:1.4}
    .plan-features li strong{color:var(--color-text);font-weight:700}
    .check-icon{flex-shrink:0;color:var(--color-text-dim)}
    .plan-features--pro .check-icon{color:var(--color-primary)}
    .feature-soon{opacity:.5}
    .soon-badge{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;padding:2px 7px;border-radius:var(--radius-full);background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.2);color:#F59E0B}
    .plan-cta{margin-top:auto}
    .plan-cta form{width:100%}
    .btn-plan{width:100%;padding:12px 24px;border-radius:var(--radius);font-size:14px;font-weight:700;cursor:pointer;transition:all .3s ease;font-family:inherit;border:none}
    .btn-plan:disabled{opacity:.5;cursor:not-allowed}
    .btn-plan--outline{background:transparent;border:1px solid var(--card-border-hover);color:var(--color-text)}
    .btn-plan--primary{background:var(--gradient-primary);color:white}
    .trust-row{display:flex;justify-content:center;gap:36px;margin-top:48px;flex-wrap:wrap;position:relative;z-index:1;animation:fadeUp .6s .35s cubic-bezier(.16,1,.3,1) both}
    .trust-item{display:flex;align-items:center;gap:8px;color:var(--color-text-dim);font-size:12px;font-weight:500}
    .faq-section{margin-top:64px;max-width:640px;margin-left:auto;margin-right:auto;position:relative;z-index:1;animation:fadeUp .6s .4s cubic-bezier(.16,1,.3,1) both}
    .faq-title{font-family:'Plus Jakarta Sans',sans-serif;font-size:20px;font-weight:800;margin:0 0 24px;letter-spacing:-.02em;text-align:center}
    .faq-list{display:flex;flex-direction:column;gap:2px}
    .faq-item{border-radius:var(--radius);overflow:hidden;background:var(--card-bg);border:1px solid var(--card-border);transition:border-color .3s ease}
    .faq-item.open{border-color:var(--card-border-hover)}
    .faq-question{display:flex;align-items:center;justify-content:space-between;width:100%;padding:16px 20px;border:none;background:transparent;color:var(--color-text);font-size:14px;font-weight:600;cursor:pointer;text-align:left;font-family:inherit;transition:color .2s}
    .faq-question:hover{color:var(--color-primary)}
    .faq-chevron{flex-shrink:0;color:var(--color-text-dim);transition:transform .3s cubic-bezier(.16,1,.3,1)}
    .faq-item.open .faq-chevron{transform:rotate(180deg)}
    .faq-answer{max-height:0;overflow:hidden;transition:max-height .35s cubic-bezier(.16,1,.3,1)}
    .faq-item.open .faq-answer{max-height:200px}
    .faq-answer p{padding:0 20px 16px;margin:0;font-size:13px;color:var(--color-text-muted);line-height:1.7}
    @keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
    @media(max-width:768px){.pricing-grid{grid-template-columns:1fr;max-width:420px;margin:0 auto}.plan-card--pro{order:-1}.price-amount{font-size:40px}.plan-card{padding:32px 24px 28px}.trust-row{flex-direction:column;align-items:center;gap:16px}.pricing-glow{width:100%}}
  </style>

  <script is:inline>
    function initPricing() {
      const section = document.querySelector('.pricing-section');
      const toggle = document.getElementById('billing-toggle');
      const saveBadge = document.getElementById('toggle-save');
      const btns = toggle?.querySelectorAll('.toggle-btn');
      const faqList = document.getElementById('faq-list');
      btns?.forEach(btn => {
        btn.addEventListener('click', () => {
          const period = btn.getAttribute('data-period');
          if (!period || !section || !toggle || !saveBadge) return;
          btns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          toggle.setAttribute('data-active', period);
          section.setAttribute('data-billing', period);
          saveBadge.classList.toggle('visible', period === 'annual');
        });
      });
      faqList?.querySelectorAll('.faq-item').forEach(item => {
        const question = item.querySelector('.faq-question');
        question?.addEventListener('click', () => {
          const wasOpen = item.classList.contains('open');
          faqList.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
          if (!wasOpen) item.classList.add('open');
        });
      });
    }
    document.addEventListener('DOMContentLoaded', initPricing);
    document.addEventListener('astro:page-load', initPricing);
  </script>
</Layout>
