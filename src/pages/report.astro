---
export const prerender = false;
import Layout from "../shared/Layout.astro";
import { defaultLocale } from "../i18n";

// Use default locale since this is a global unlisted page
const locale = defaultLocale;
---

<Layout title="Report Issue" locale={locale}>
  <main class="min-h-screen bg-slate-50 flex flex-col items-center justify-center p-4">
    <!-- Header -->
    <div class="text-center mb-6">
      <h1 class="text-3xl font-bold text-slate-900 mb-2">Report an Issue</h1>
      <p class="text-slate-600 max-w-md mx-auto">
        Found a bug or have a feature request? Let us know.
      </p>
    </div>

    <!-- Main Card -->
    <div class="w-full max-w-lg bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden relative">
      
      <!-- Content Wrapper -->
      <div class="p-6 md:p-8">
        
        <!-- Form Section -->
        <form id="report-form">
          
          <!-- Issue Type (Dropdown Select) -->
          <div class="mb-6">
            <label for="type" class="block text-sm font-semibold text-slate-900 mb-2">Issue Type</label>
            <div class="relative">
              <select
                id="type"
                name="type"
                class="w-full appearance-none rounded-lg border-slate-300 border px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-all shadow-sm bg-white text-slate-700 pr-10"
              >
                <option value="bug">Bug Report</option>
                <option value="feature_request">Feature Request</option>
                <option value="other">Other Inquiry</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-500">
                <svg class="h-4 w-4" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </div>
          </div>

          <!-- Title Field -->
          <div class="mb-6">
            <label for="title" class="block text-sm font-semibold text-slate-900 mb-2">
              Title <span class="text-slate-400 font-normal ml-1">(Optional)</span>
            </label>
            <input
              type="text"
              id="title"
              name="title"
              class="w-full rounded-lg border-slate-300 border px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-all shadow-sm placeholder:text-slate-400"
              placeholder="Brief summary"
            />
          </div>

          <!-- Description Field -->
          <div class="mb-6">
            <label for="description" class="block text-sm font-semibold text-slate-900 mb-2">
              Description <span class="text-red-500 ml-0.5">*</span>
            </label>
            <textarea
              id="description"
              name="description"
              required
              rows="4"
              class="w-full rounded-lg border-slate-300 border px-3 py-2.5 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-all shadow-sm resize-none placeholder:text-slate-400"
              placeholder="Please describe the issue..."
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-4 mt-2">
            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-gradient-to-r from-blue-600 to-violet-600 hover:from-blue-700 hover:to-violet-700 text-white font-semibold py-3 px-4 rounded-xl transition-all duration-200 flex items-center justify-center gap-2 text-sm shadow-lg hover:shadow-xl transform active:scale-[0.98]"
            >
              <span>Submit Report</span>
            </button>
          </div>
        </form>

        <!-- Success Message (Initially Hidden via CSS) -->
        <div id="success-message" style="display: none;" class="text-center py-8">
          <div class="inline-flex items-center justify-center w-12 h-12 bg-green-100 text-green-600 rounded-full mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">Received!</h3>
          <p class="text-slate-600 mb-6 text-sm">Thanks for your feedback.</p>
          <button
            onclick="window.location.reload()"
            class="text-sm text-slate-900 font-medium hover:underline outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500 rounded-sm"
          >
            Submit another
          </button>
        </div>

      </div>
    </div>
    
    <p class="mt-6 text-xs text-slate-400">
      &copy; {new Date().getFullYear()} FastScout
    </p>
  </main>
</Layout>

<script>
  const form = document.getElementById('report-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMessage = document.getElementById('success-message') as HTMLDivElement;
  
  // Store original button content
  const originalBtnContent = submitBtn.innerHTML;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Disable and show loading
    submitBtn.disabled = true;
    submitBtn.innerHTML = `
      <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Sending...</span>
    `;

    const formData = new FormData(form);
    const data = {
      title: formData.get('title'),
      description: formData.get('description'),
      type: formData.get('type'),
      source: 'report_page',
      metadata: {
        userAgent: navigator.userAgent,
        url: window.location.href
      }
    };

    try {
      const response = await fetch('/api/report', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (!response.ok) throw new Error('Failed to submit');

      // Hide form, show success
      form.style.display = 'none';
      successMessage.style.display = 'block';

    } catch (error) {
      console.error('Error:', error);
      alert('Failed to submit. Please try again.');
      
      // Reset button
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalBtnContent;
    }
  });
</script>
