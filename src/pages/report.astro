---
export const prerender = false;
import Layout from "../shared/Layout.astro";
import { defaultLocale } from "../i18n";

// Use default locale since this is a global unlisted page
const locale = defaultLocale;
---

<Layout title="Report Issue" locale={locale}>
  <!-- Background Glow Effects -->
  <div class="fixed top-0 left-0 right-0 h-[500px] pointer-events-none z-0">
    <div class="absolute top-[-20%] left-1/2 transform -translate-x-1/2 w-[800px] h-[600px] bg-gradient-to-b from-blue-50/50 to-transparent rounded-full blur-[100px]"></div>
  </div>

  <main class="relative z-10 min-h-screen flex flex-col items-center justify-center p-4">
    <!-- Header Section -->
    <div class="mb-8 text-center max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-sm font-medium mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
        </span>
        Feedback & Support
      </div>
      
      <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">
        Report an Issue
      </h1>
      <p class="text-lg text-slate-600 max-w-lg mx-auto leading-relaxed">
        Help us improve FastScout. Let us know about bugs, feature requests, or share your general feedback.
      </p>
    </div>

    <!-- Card Container -->
    <div class="w-full max-w-lg bg-white/80 backdrop-blur-xl rounded-3xl shadow-float border border-white/50 p-8 md:p-10 relative overflow-hidden transition-all duration-300 hover:shadow-glow">
      
      <!-- Card Decorative Elements -->
      <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-blue-500/5 to-violet-500/5 rounded-bl-full pointer-events-none"></div>

      <div class="relative z-10">
        <form id="report-form" class="space-y-6">
          <!-- Type Selection -->
          <div class="space-y-2">
            <label class="text-sm font-semibold text-slate-900 ml-1">Issue Type</label>
            <div class="grid grid-cols-3 gap-2 p-1.5 bg-slate-100/50 rounded-2xl border border-slate-200/50">
              <label class="cursor-pointer group relative">
                <input type="radio" name="type" value="bug" class="peer sr-only" checked />
                <div class="py-2.5 text-center text-sm font-medium text-slate-600 rounded-xl transition-all duration-200 peer-checked:bg-white peer-checked:text-blue-600 peer-checked:shadow-sm hover:bg-white/50 hover:text-slate-900">
                  Bug
                </div>
              </label>
              <label class="cursor-pointer group relative">
                <input type="radio" name="type" value="feature_request" class="peer sr-only" />
                <div class="py-2.5 text-center text-sm font-medium text-slate-600 rounded-xl transition-all duration-200 peer-checked:bg-white peer-checked:text-violet-600 peer-checked:shadow-sm hover:bg-white/50 hover:text-slate-900">
                  Feature
                </div>
              </label>
              <label class="cursor-pointer group relative">
                <input type="radio" name="type" value="other" class="peer sr-only" />
                <div class="py-2.5 text-center text-sm font-medium text-slate-600 rounded-xl transition-all duration-200 peer-checked:bg-white peer-checked:text-emerald-600 peer-checked:shadow-sm hover:bg-white/50 hover:text-slate-900">
                  Other
                </div>
              </label>
            </div>
          </div>

          <!-- Title -->
          <div class="space-y-2">
            <label for="title" class="text-sm font-semibold text-slate-900 ml-1">Title <span class="text-slate-400 font-normal">(Optional)</span></label>
            <input
              type="text"
              id="title"
              name="title"
              class="w-full px-4 py-3 rounded-xl bg-slate-50/50 border border-slate-200 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all duration-200"
              placeholder="Brief summary of the issue"
            />
          </div>

          <!-- Description -->
          <div class="space-y-2">
            <label for="description" class="text-sm font-semibold text-slate-900 ml-1">Description <span class="text-red-500">*</span></label>
            <textarea
              id="description"
              name="description"
              required
              rows="5"
              class="w-full px-4 py-3 rounded-xl bg-slate-50/50 border border-slate-200 text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 outline-none transition-all duration-200 resize-none leading-relaxed"
              placeholder="Please describe what happened, steps to reproduce, or your idea..."
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            id="submit-btn"
            class="w-full group relative py-3.5 px-4 bg-gradient-to-r from-blue-600 to-violet-600 hover:from-blue-700 hover:to-violet-700 text-white font-semibold rounded-xl shadow-lg shadow-blue-500/25 transform transition-all duration-200 active:scale-[0.98] disabled:opacity-70 disabled:cursor-not-allowed overflow-hidden"
          >
            <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></div>
            <div class="relative flex items-center justify-center gap-2">
              <span>Submit Report</span>
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </div>
          </button>
        </form>

        <!-- Success Message (Hidden by default) -->
        <div id="success-message" class="hidden text-center py-12">
          <div class="w-20 h-20 bg-green-50 text-green-500 rounded-full flex items-center justify-center mx-auto mb-6 ring-8 ring-green-50/50">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h2 class="text-3xl font-bold text-slate-900 mb-3">Thank You!</h2>
          <p class="text-slate-600 mb-8 max-w-xs mx-auto">Your report has been submitted successfully. We appreciate your contribution to FastScout.</p>
          <button
            onclick="window.location.reload()"
            class="inline-flex items-center gap-2 px-6 py-2.5 bg-white border border-slate-200 rounded-xl text-slate-700 font-medium hover:bg-slate-50 hover:border-slate-300 hover:text-slate-900 transition-all shadow-sm"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            Submit another report
          </button>
        </div>
      </div>
    </div>
    
    <div class="mt-8 text-center">
      <p class="text-sm text-slate-400">
        &copy; {new Date().getFullYear()} FastScout. All rights reserved.
      </p>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('report-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMessage = document.getElementById('success-message') as HTMLDivElement;
  const originalBtnText = submitBtn.innerHTML;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Disable button and show loading state
    submitBtn.disabled = true;
    submitBtn.innerHTML = `
      <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      Sending...
    `;

    const formData = new FormData(form);
    const data = {
      title: formData.get('title'),
      description: formData.get('description'),
      type: formData.get('type'),
      source: 'report_page',
      metadata: {
        userAgent: navigator.userAgent,
        url: window.location.href,
        referrer: document.referrer
      }
    };

    try {
      const response = await fetch('/api/report', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      if (!response.ok) {
        throw new Error('Failed to submit report');
      }

      // Show success message
      form.classList.add('hidden');
      successMessage.classList.remove('hidden');

    } catch (error) {
      console.error('Error submitting report:', error);
      alert('Failed to submit report. Please try again.');
      
      // Reset button
      submitBtn.disabled = false;
      submitBtn.innerHTML = originalBtnText;
    }
  });
</script>
