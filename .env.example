# Site URL used for OAuth callbacks and Stripe URLs
SITE_URL=http://localhost:4321

# Convex project URL (from Convex dashboard or `npx convex dev` output)
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Stripe API keys and product/price configuration
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Subscription prices for each billing interval
STRIPE_PRICE_ID_MONTHLY=price_xyz
STRIPE_PRICE_ID_YEARLY=price_xyz
STRIPE_PRICE_ID_QUARTERLY=price_xyz
STRIPE_PRICE_ID_HALFYEARLY=price_xyz

# Optional: Pre-configured price amounts (in cents) to avoid Stripe API calls on pricing page
# If not set, prices are fetched from Stripe API as fallback
STRIPE_PRICE_MONTHLY_AMOUNT=500
STRIPE_PRICE_YEARLY_AMOUNT=5000
STRIPE_PRICE_CURRENCY=USD

# JWT secret used to sign extension tokens (minimum 32 characters required)
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your_secret_here_min_32_chars_use_openssl_rand

# Chrome extension ID to allow CORS to chrome-extension://<ID>
CHROME_EXTENSION_ID=abc123

# OAuth credentials — set these in Convex dashboard environment variables, NOT here:
# AUTH_GITHUB_ID, AUTH_GITHUB_SECRET
# AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET
